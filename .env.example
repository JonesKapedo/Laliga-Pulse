# Public URL of the deployed app (used for OAuth callbacks, OG images and PWA).
# Local development defaults to http://localhost:8080.
BETTER_AUTH_URL=http://localhost:8080

# Required in production. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Neon Postgres connection string. Omit locally to use the embedded PGlite.
DATABASE_URL=

# Optional: set to "false" to disable sign-in everywhere and use the dev user.
VITE_AUTH_ENABLED=true

# Public app URL exposed to the client (absolute OG image URLs).
VITE_APP_URL=http://localhost:8080

# OAuth providers (enable any subset). Leave blank to keep auth off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
